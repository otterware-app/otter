{
  "name": "otter-mail-site",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    // Every old-domain URL, including static assets and /app, must redirect.
    "run_worker_first": true,
  },
  "workers_dev": false,
  "routes": [
    { "pattern": "mail.otterware.app", "custom_domain": true },
    { "pattern": "mail.otterware.dev", "custom_domain": true },
  ],
  "services": [{ "binding": "NIGHTLY", "service": "otter-mail-site-nightly" }],
  "env": {
    // Reachable only through the stable Worker's NIGHTLY binding.
    "nightly": {
      "name": "otter-mail-site-nightly",
      "workers_dev": false,
      "routes": [],
      "services": [],
    },
  },
}
