{
  "name": "@otter/extension-hermes",
  "version": "0.1.0",
  "private": true,
  "description": "Chats with your Hermes Agent server.",
  "type": "module",
  "exports": {
    "./manifest": "./manifest.ts",
    "./core": "./core/index.ts",
    "./ui": "./ui/index.tsx",
    "./mobile": "./mobile/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vp test run --passWithNoTests"
  },
  "dependencies": {
    "@otter/client": "workspace:*",
    "@otter/contracts": "workspace:*",
    "@otter/core": "workspace:*",
    "@otter/mobile": "workspace:*",
    "@otter/ui": "workspace:*",
    "@otter/ui-native": "workspace:*",
    "react": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "expo-image": "catalog:",
    "react-native": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "expo-image": "*",
    "react-native": "*"
  },
  "otter": {
    "id": "hermes",
