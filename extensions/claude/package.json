{
  "name": "@otter/extension-claude",
  "version": "0.1.0",
  "private": true,
  "description": "Runs Claude Code, installed on this computer.",
  "type": "module",
  "exports": {
    "./manifest": "./manifest.ts",
    "./desktop": "./desktop/index.ts",
    "./ui": "./ui/index.tsx",
    "./mobile": "./mobile/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vp test run --passWithNoTests"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.282",
    "@otter/contracts": "workspace:*",
    "@otter/core": "workspace:*",
    "@otter/mobile": "workspace:*",
    "@otter/ui": "workspace:*",
    "react": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react-native": "catalog:",
    "react-native-svg": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react-native": "*",
    "react-native-svg": "*"
  },
  "otter": {
    "id": "claude",
    "name": "Claude",
    "description": "Runs Claude Code, installed on this computer.",
    "category": "agent",
    "dataUse": "Runs Claude Code on this computer. Your messages, and the mail and calendar data its tools read, go to Anthropic.",
    "platforms": [
      "mac",
      "linux"
    ]
  }
}
