{
  "name": "@otterware/openclaw-otter",
  "version": "0.2.7",
  "description": "Otter as an OpenClaw channel: what your agents send you waits in Otter, and Otter tells your devices.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otterware-app/otter.git",
    "directory": "extensions/openclaw/gateway"
  },
  "files": [
    "index.js",
    "control.js",
    "files.js",
    "otter.js",
    "openclaw.plugin.json"
  ],
  "type": "module",
  "peerDependencies": {
    "openclaw": ">=2026.11.1"
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "channel": {
      "id": "otter",
      "label": "Otter",
      "blurb": "Send what your agents want you to see to Otter."
    },
    "compat": {
      "pluginApi": ">=2026.11.1"
    },
    "build": {
      "openclawVersion": "2026.11.1"
    }
  }
}
