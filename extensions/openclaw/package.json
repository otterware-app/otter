    "@otter/mobile": "workspace:*",
    "@otter/ui": "workspace:*",
    "@otter/ui-native": "workspace:*",
    "lucide-react": "^0.542.0",
    "react": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "react-native": "catalog:",
    "react-native-svg": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react-native": "*",
