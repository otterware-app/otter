{
  "name": "@otter/extension-openclaw",
  "version": "0.1.0",
  "private": true,
  "description": "Chats with your OpenClaw gateway.",
  "type": "module",
  "exports": {
    "./manifest": "./manifest.ts",
    "./core": "./core/index.ts",
    "./ui": "./ui/index.tsx",
    "./mobile": "./mobile/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vp test run --passWithNoTests"
  },
  "dependencies": {
    "@openclaw/gateway-client": "2026.9.9",
    "@otter/client": "workspace:*",
    "@otter/contracts": "workspace:*",
