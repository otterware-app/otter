{
  "name": "@otter-mail/mobile",
  "version": "0.9.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:dev": "APP_VARIANT=development expo start",
    "ios": "EXPO_NO_GIT_STATUS=1 expo prebuild --clean --platform ios && expo run:ios",
    "ios:dev": "APP_VARIANT=development EXPO_NO_GIT_STATUS=1 expo prebuild --clean --platform ios && expo run:ios",
    "ios:preview": "APP_VARIANT=preview EXPO_NO_GIT_STATUS=1 expo prebuild --clean --platform ios && expo run:ios",
    "ios:prod": "APP_VARIANT=production EXPO_NO_GIT_STATUS=1 expo prebuild --clean --platform ios && expo run:ios",
    "ios:release": "APP_VARIANT=development EXPO_NO_GIT_STATUS=1 expo prebuild --clean --platform ios && expo run:ios --configuration Release --no-bundler",
    "config:dev": "APP_VARIANT=development expo config",
    "config:preview": "APP_VARIANT=preview expo config",
    "config:prod": "APP_VARIANT=production expo config",
    "nitrogen": "pnpm -r --filter './modules/*' nitrogen",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "gate:server": "node scripts/gate-server.mts",
    "build:composer": "node scripts/build-composer.mts"
  },
  "dependencies": {
    "@effect/atom-react": "catalog:",
    "@expo/ui": "58.0.20",
    "@legendapp/list": "catalog:",
    "@noble/hashes": "catalog:",
    "@otter-mail/client-runtime": "workspace:*",
    "@otter-mail/contracts": "workspace:*",
    "@otter-mail/core": "workspace:*",
    "@otter-mail/extension-calendar-invites": "workspace:*",
    "@otter-mail/extension-hermes": "workspace:*",
    "@otter-mail/extension-openclaw": "workspace:*",
    "@otter-mail/extension-openrouter": "workspace:*",
    "@otter-mail/extension-sign-in-codes": "workspace:*",
    "@otter-mail/extension-translation": "workspace:*",
    "@otter-mail/mobile-app": "workspace:*",
    "@otter-mail/mobile-background": "workspace:*",
    "@otter-mail/mobile-composer": "workspace:*",
    "@otter-mail/mobile-credentials": "workspace:*",
    "@otter-mail/mobile-html-view": "workspace:*",
    "@otter-mail/mobile-net": "workspace:*",
    "@otter-mail/mobile-socket": "workspace:*",
    "@otter-mail/mobile-sqlite": "workspace:*",
    "@otter-mail/mobile-translation": "workspace:*",
    "@otter-mail/mobile-worker": "workspace:*",
    "@otter-mail/shared": "workspace:*",
    "@react-navigation/elements": "2.9.45",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@sentry/react-native": "8.32.0",
    "@ungap/structured-clone": "1.4.0",
    "better-auth": "^1.7.6",
    "effect": "catalog:",
    "expo": "58.0.14",
    "expo-build-properties": "~58.0.11",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "58.0.4",
    "expo-haptics": "~58.0.7",
    "expo-notifications": "~58.1.8",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "58.0.4",
    "expo-symbols": "~58.0.4",
    "postal-mime": "^4.0.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-nitro-modules": "0.37.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "4.30.1",
    "react-native-worklets": "0.13.0",
    "web-streams-polyfill": "4.5.0",
    "whatwg-url-minimum": "0.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "catalog:",
    "babel-preset-expo": "~58.0.17",
    "esbuild": "^0.25.12",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    },
    "autolinking": {
      "buildFromSource": [
        "@expo/ui",
        "expo-ui",
        "expo-glass-effect",
        "expo-notifications",
        "react-native-screens"
      ]
    }
  }
}
