{
  "name": "@otter/core",
  "version": "0.1.0",
  "private": true,
  "description": "The mail backend shared by the desktop app (Electron main process) and the web app (a Web Worker).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./agent-instructions": "./src/services/agent/instructions.ts",
    "./imap": "./src/protocols/imap/client.ts",
    "./extension-kit": "./src/extension-kit.ts",
    "./fake": "./src/fake/index.ts"
  },
  "scripts": {
    "test": "vp test run --passWithNoTests",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/protocols/test && tsc --noEmit -p src/providers/imap/test && tsc --noEmit -p src/services/test"
  },
  "dependencies": {
    "@otter/contracts": "workspace:*",
    "@otter/shared": "workspace:*",
    "better-auth": "^1.7.6",
    "postal-mime": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
