                                  "name": "Head",
                                  "fill": "$foreground",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Agents write in the margin.",
                                  "fontFamily": "$font-reading",
                                  "fontSize": 28,
                                  "fontWeight": "normal",
                                  "letterSpacing": -0.4
                                },
                                {
                                  "type": "text",
                                  "id": "c0isl",
                                  "name": "Body",
                                  "fill": "$muted-foreground",
                                  "textGrowth": "fixed-width",
                                  "width": 760,
                                  "content": "An agent’s work is marginalia: set in serif italic, hung beside the line it’s about, with a hairline to it. Accept with ↵, dismiss with ⌫. The chat exists, but it’s where you go, not what follows you.",
                                  "lineHeight": 1.55,
                                  "fontFamily": "$font-sans",
                                  "fontSize": 16,
                                  "fontWeight": "normal"
                                }
