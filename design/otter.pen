                                  "type": "text",
                                  "id": "QYDnj",
                                  "name": "Head",
                                  "fill": "$foreground",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Color is a verb.",
                                  "fontFamily": "$font-reading",
                                  "fontSize": 28,
                                  "fontWeight": "normal",
                                  "letterSpacing": -0.4
                                },
                                {
                                  "type": "text",
                                  "id": "sqwHi",
                                  "name": "Body",
                                  "fill": "$muted-foreground",
                                  "textGrowth": "fixed-width",
                                  "width": 760,
                                  "content": "Neutrals for everything. Vermilion only for “needs you”: an unanswered question, a meeting starting, an agent waiting. Green only for settled. If you can see color, you have something to do.",
                                  "lineHeight": 1.55,
                                  "fontFamily": "$font-sans",
                                  "fontSize": 16,
                                  "fontWeight": "normal"
                                }
                              ]
                            }
