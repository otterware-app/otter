                                {
                                  "type": "text",
                                  "id": "ixrd1",
                                  "name": "Head",
                                  "fill": "$foreground",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "One column, one decision.",
                                  "fontFamily": "$font-reading",
                                  "fontSize": 28,
                                  "fontWeight": "normal",
                                  "letterSpacing": -0.4
                                },
                                {
                                  "type": "text",
                                  "id": "WjCGm",
                                  "name": "Body",
                                  "fill": "$muted-foreground",
                                  "textGrowth": "fixed-width",
                                  "width": 760,
                                  "content": "Content sits at a 680px measure, centered on the paper. The list becomes the reader becomes the composer, in place. Navigation is a quiet rail and ⌘K, never a third pane.",
                                  "lineHeight": 1.55,
                                  "fontFamily": "$font-sans",
                                  "fontSize": 16,
                                  "fontWeight": "normal"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "frame",
