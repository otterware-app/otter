                                  "width": "fill_container",
                                  "content": "Settle, don’t file.",
                                  "fontFamily": "$font-reading",
                                  "fontSize": 28,
                                  "fontWeight": "normal",
                                  "letterSpacing": -0.4
                                },
                                {
                                  "type": "text",
                                  "id": "nJqB8",
                                  "name": "Body",
                                  "fill": "$muted-foreground",
                                  "textGrowth": "fixed-width",
                                  "width": 760,
                                  "content": "Things aren’t archived, labeled or moved: they’re settled (⌘D) and leave the page with a tick. The Desk is empty when your day is done, and says so in one line.",
